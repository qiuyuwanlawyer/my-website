---
type Props = {
  slug: string;
  title: string;
  total: number;
  pages: number[];
};

const { slug, title, total, pages } = Astro.props;
const base = `/whitepapers/${slug}`;
const pad = (n: number) => String(n).padStart(2, "0");
---

<section class="wp-reader" aria-label={`${title}在线阅读`}>
  <div class="wp-stage-wrap">
    <button type="button" class="wp-nav wp-prev" data-wp-prev aria-label="上一页">‹</button>
    <figure class="wp-stage" data-wp-stage>
      <img
        data-wp-img
        src={`${base}/p1.jpg`}
        alt={`${title}第 1 页`}
        width="1008"
        height="1427"
        decoding="async"
      />
      <figcaption class="wp-hint">点击页面可放大 · 左右滑动翻页 · 方向键翻页</figcaption>
    </figure>
    <button type="button" class="wp-nav wp-next" data-wp-next aria-label="下一页">›</button>
  </div>

  <div class="wp-toolbar">
    <span class="wp-counter" data-wp-counter>{pad(1)} / {total}</span>
    <div class="wp-strip" data-wp-strip aria-label="页面缩略图">
      {pages.map((n) => (
        <button
          type="button"
          class:list={["wp-thumb", n === 1 && "is-active"]}
          data-page={n}
          aria-label={`跳到第 ${n} 页`}
        >
          <img src={`${base}/t${n}.jpg`} alt="" width="150" height="212" loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
  </div>
</section>

<div class="wp-lightbox" data-wp-lightbox hidden>
  <img data-wp-lightbox-img src={`${base}/p1.jpg`} alt={`${title}页面放大视图`} />
</div>

<script is:inline define:vars={{ BASE: base, TOTAL: total, TITLE: title }}>
  (() => {
    const stage = document.querySelector("[data-wp-stage]");
    const img = document.querySelector("[data-wp-img]");
    const counter = document.querySelector("[data-wp-counter]");
    const strip = document.querySelector("[data-wp-strip]");
    const lightbox = document.querySelector("[data-wp-lightbox]");
    const lightboxImg = document.querySelector("[data-wp-lightbox-img]");
    if (!stage || !img || !counter || !strip || !lightbox || !lightboxImg) return;

    const thumbs = Array.from(strip.querySelectorAll(".wp-thumb"));
    const pad2 = (n) => String(n).padStart(2, "0");
    let cur = 1;
    let busy = false;

    const src = (n) => `${BASE}/p${n}.jpg`;

    const show = (n) => {
      const next = Math.min(TOTAL, Math.max(1, n));
      if (next === cur && img.src.endsWith(`p${cur}.jpg`)) return;
      cur = next;
      busy = true;
      img.style.opacity = "0";
      const loader = new Image();
      loader.src = src(cur);
      loader.onload = () => {
        img.src = loader.src;
        img.alt = `${TITLE}第 ${cur} 页`;
        img.style.opacity = "1";
        busy = false;
      };
      counter.textContent = `${pad2(cur)} / ${TOTAL}`;
      thumbs.forEach((t, i) => t.classList.toggle("is-active", i === cur - 1));
      thumbs[cur - 1]?.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
      [cur - 1, cur + 1].forEach((k) => {
        if (k >= 1 && k <= TOTAL) new Image().src = src(k);
      });
    };

    document.querySelector("[data-wp-prev]")?.addEventListener("click", () => show(cur - 1));
    document.querySelector("[data-wp-next]")?.addEventListener("click", () => show(cur + 1));
    thumbs.forEach((t) => t.addEventListener("click", () => show(Number(t.dataset.page))));

    document.addEventListener("keydown", (e) => {
      if (!lightbox.hidden) {
        if (e.key === "Escape") lightbox.hidden = true;
        return;
      }
      if (e.key === "ArrowLeft") show(cur - 1);
      if (e.key === "ArrowRight") show(cur + 1);
    });

    let sx = 0;
    let sy = 0;
    stage.addEventListener("touchstart", (e) => {
      sx = e.touches[0].clientX;
      sy = e.touches[0].clientY;
    }, { passive: true });
    stage.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      const dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4) show(cur + (dx < 0 ? 1 : -1));
    }, { passive: true });

    stage.addEventListener("click", () => {
      if (!busy) {
        lightboxImg.src = src(cur);
        lightbox.hidden = false;
      }
    });
    lightbox.addEventListener("click", () => (lightbox.hidden = true));
  })();
</script>

<style>
  .wp-reader {
    background: linear-gradient(180deg, var(--deep) 0%, var(--deep-2) 100%);
    color: var(--ink);
    padding: 56px 20px 44px;
  }

  .wp-stage-wrap {
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 56px;
    align-items: center;
    gap: 14px;
  }

  .wp-stage {
    margin: 0;
    position: relative;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    cursor: zoom-in;
  }

  .wp-stage img {
    display: block;
    width: 100%;
    max-width: 760px;
    height: auto;
    margin: 0 auto;
    transition: opacity 220ms var(--ease-out);
  }

  .wp-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -30px;
    text-align: center;
    font-size: 12.5px;
    color: var(--muted);
  }

  .wp-nav {
    width: 100%;
    height: 72px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink);
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
    transition: background 160ms var(--ease-out), border-color 160ms var(--ease-out);
  }

  .wp-nav:hover {
    background: rgba(240, 195, 59, 0.16);
    border-color: var(--gold);
  }

  .wp-toolbar {
    max-width: 1080px;
    margin: 44px auto 0;
  }

  .wp-counter {
    display: block;
    text-align: center;
    font-size: 13px;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .wp-strip {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 6px 2px 10px;
    scrollbar-width: thin;
  }

  .wp-thumb {
    flex: 0 0 auto;
    width: 68px;
    padding: 0;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.06);
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 160ms var(--ease-out), border-color 160ms var(--ease-out);
  }

  .wp-thumb img {
    display: block;
    width: 100%;
    height: auto;
  }

  .wp-thumb:hover {
    opacity: 0.9;
  }

  .wp-thumb.is-active {
    opacity: 1;
    border-color: var(--gold);
    box-shadow: 0 0 0 1px var(--gold);
  }

  .wp-lightbox {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(3, 15, 30, 0.93);
    overflow: auto;
    cursor: zoom-out;
    text-align: center;
    padding: 24px 12px;
  }

  .wp-lightbox img {
    max-width: 1200px;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }

  @media (max-width: 760px) {
    .wp-reader {
      padding: 36px 12px 34px;
    }

    .wp-stage-wrap {
      grid-template-columns: 42px minmax(0, 1fr) 42px;
      gap: 8px;
    }

    .wp-nav {
      height: 54px;
      font-size: 22px;
    }

    .wp-hint {
      bottom: -24px;
      font-size: 11px;
    }

    .wp-thumb {
      width: 52px;
    }

    .wp-lightbox img {
      width: auto;
      max-width: none;
      height: 94vh;
    }
  }
</style>
