---
import "../styles/global.css";

const {
  title = "邱煜完律师 | 个人网站",
  description = "邱煜完律师专注于争议解决、税务合规、企业刑事风险处置与 AI 行业数据合规服务。",
  bodyClass = ""
} = Astro.props;

const navItems = [
  { href: "/", label: "首页" },
  { href: "/about", label: "关于我" },
  { href: "/products", label: "产品与服务" },
  { href: "/articles", label: "平台文章" }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <a class="brand" href="/" aria-label="返回首页">
        <strong>邱煜完律师</strong>
        <span>QIU YUWAN LAWYER</span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        {navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <strong>邱煜完律师</strong>
        <p>争议解决 · 税务合规 · 企业刑事风险 · AI 数据合规</p>
      </div>
      <p>© {new Date().getFullYear()} 邱煜完律师. All rights reserved.</p>
    </footer>
  </body>
</html>
