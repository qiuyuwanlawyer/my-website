---
import "../styles/global.css";

const {
  title = "邱煜完律师 | 个人网站",
  description = "邱煜完律师专注于争议解决、税务合规、企业刑事风险处置与 AI 行业数据合规服务。",
  bodyClass = "",
  pageSchema = null,
  noindex = false
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const personId = "https://qiuyuwan.cn/#person";
const websiteId = "https://qiuyuwan.cn/#website";
const baseSchema = [
  {
    "@type": "WebSite",
    "@id": websiteId,
    name: "邱煜完律师个人网站",
    url: "https://qiuyuwan.cn/",
    inLanguage: "zh-CN",
    author: { "@id": personId }
  },
  {
    "@type": "Person",
    "@id": personId,
    name: "邱煜完",
    jobTitle: "律师",
    url: "https://qiuyuwan.cn/about",
    knowsAbout: ["刑事辩护与刑事风险处置", "税务合规与税务争议", "AI 与数据合规", "民商事争议解决"]
  },
  {
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: title,
    description,
    inLanguage: "zh-CN",
    isPartOf: { "@id": websiteId },
    author: { "@id": personId }
  }
];
const schemaGraph = pageSchema ? [...baseSchema, pageSchema] : baseSchema;

const navItems = [
  { href: "/", label: "首页" },
  { href: "/about", label: "关于我" },
  { href: "/products", label: "产品与服务" },
  { href: "/articles", label: "平台文章" },
  { href: "/videos", label: "访谈视频" },
  { href: "/podcast", label: "播客" }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": schemaGraph })}></script>
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="返回首页">
        <strong>邱煜完律师</strong>
        <span>QIU YUWAN LAWYER</span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        {navItems.map((item) => (
          <a href={item.href} aria-current={Astro.url.pathname === item.href ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
      <details class="mobile-nav">
        <summary aria-label="打开网站导航"><span>菜单</span></summary>
        <nav aria-label="移动端主导航">
          {navItems.map((item) => (
            <a href={item.href} aria-current={Astro.url.pathname === item.href ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </details>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-main">
        <div>
          <strong>邱煜完律师</strong>
          <p>争议解决 · 税务合规 · 企业刑事风险 · AI 数据合规</p>
        </div>
        <p>© {new Date().getFullYear()} 邱煜完律师. All rights reserved.</p>
      </div>
      <div class="site-records" aria-label="网站备案信息">
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">浙ICP备2026051467号</a>
        <a href="https://beian.gov.cn/" target="_blank" rel="noopener noreferrer">浙公网安备33010902004920号</a>
      </div>
    </footer>
    <script is:inline>
      document.addEventListener("click", async (event) => {
        const button = event.target.closest(".wechat-copy-btn");
        if (!button) return;
        const id = button.dataset.wechat || "qiuyuwan580";
        try {
          await navigator.clipboard.writeText(id);
        } catch (error) {
          const textarea = document.createElement("textarea");
          textarea.value = id;
          textarea.style.position = "fixed";
          textarea.style.opacity = "0";
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand("copy");
          textarea.remove();
        }
        button.textContent = "已复制 ✓";
        button.classList.add("is-copied");
        window.setTimeout(() => {
          button.textContent = "复制微信号";
          button.classList.remove("is-copied");
        }, 2000);
      });
    </script>
  </body>
</html>
