---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  {
    title: "争议解决专项",
    promise: "把纠纷从情绪和压力中拆出来，围绕事实、证据、商业目标和回款可能性，确定可执行的处置路径。",
    client: "企业、股东、实际控制人及公司高管",
    problems: ["重大合同履行与违约争议", "股东、公司治理及控制权纠纷", "建设工程、能源项目与复杂交易争议", "谈判、诉讼、仲裁及执行衔接"],
    output: ["争议全景与路径评估", "证据审查、补强及保全清单", "谈判方案与诉讼 / 仲裁策略", "程序推进与执行回款建议"],
    boundary: "服务方案需在审阅合同、往来记录及核心证据后确定；不对案件结果作承诺。"
  },
  {
    title: "税务合规与税务争议",
    promise: "在稽查、补税、发票和历史税务问题中，先还原业务与资金链条，再安排说明、沟通和整改顺序。",
    client: "处于快速发展、业务调整、融资并购或税务检查阶段的企业",
    problems: ["税务稽查、风险提示与纳税评估", "发票取得、开具及上下游传导风险", "历史税务问题梳理与整改", "重大交易、股权与业务模式税务风险"],
    output: ["业务—合同—资金—发票链条核查", "风险事项分级与材料清单", "税企沟通及书面说明方案", "整改路径与后续合规机制"],
    boundary: "法律分析不替代审计、鉴证或纳税申报；需要时可与财税专业人员协同。"
  },
  {
    title: "企业刑事风险处置",
    promise: "在经营风险出现苗头或程序已经启动时，尽早识别个人责任边界，稳住材料、沟通与应对节奏。",
    client: "企业家、实际控制人、高管、财务负责人及核心业务人员",
    problems: ["经营行为可能涉及的刑事风险", "企业责任与个人责任的区分", "高管、财务及业务岗位责任边界", "报案、调查、讯问等程序应对"],
    output: ["事实链条与风险节点梳理", "人员职责和责任边界分析", "材料准备、沟通口径与应对预案", "前置合规及风险隔离建议"],
    boundary: "刑事风险高度依赖具体事实与程序阶段；紧急情形应尽早提供完整信息并及时介入。"
  },
  {
    title: "AI 数据合规服务",
    promise: "围绕数据从哪里来、如何处理、交付给谁和怎样商业化，把抽象规则翻译为业务能执行的合规动作。",
    client: "AI 产品团队、数据服务商、平台企业及推进数字化项目的公司",
    problems: ["训练、检索与业务数据来源合法性", "个人信息、重要数据及委托处理安排", "模型输出、数据产品和接口商业化", "平台规则、知识产权与合同责任分配"],
    output: ["数据流与参与主体盘点", "合规差距及风险优先级清单", "隐私政策、授权文本与合同条款", "业务流程整改及上线审查建议"],
    boundary: "以具体产品、数据流和商业模式为审查对象；不以通用模板替代业务事实核验。"
  }
];
---

<BaseLayout
  title="产品与服务 | 邱煜完律师"
  pageSchema={{
    "@type": "ItemList",
    "@id": "https://qiuyuwan.cn/products#services",
    name: "邱煜完律师产品与服务",
    numberOfItems: services.length,
    itemListElement: services.map((service, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Service",
        name: service.title,
        description: service.promise,
        provider: { "@id": "https://qiuyuwan.cn/#person" },
        areaServed: { "@type": "Country", name: "中国" }
      }
    }))
  }}
>
  <section class="proposal-hero">
    <div>
      <p>企业经营风险法律服务</p>
      <h1>产品与服务</h1>
      <span>
        围绕企业从日常经营到高压争议的关键风险，提供诊断、方案与落地支持。先把问题看清，再决定是否谈判、整改或进入程序。
      </span>
    </div>
  </section>

  <section class="proposal-section">
    <div class="proposal-intro">
      <h2>四个服务入口</h2>
      <p>
        法律服务不是套用固定模板。以下入口帮助您识别问题归属；具体范围、周期与工作成果，将根据材料和所处阶段另行确认。
      </p>
    </div>

    <div class="proposal-services">
      {services.map((service, index) => (
        <article class="proposal-service">
          <div class="proposal-service-head">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{service.title}</h3>
          </div>
          <p class="proposal-promise">{service.promise}</p>
          <p class="proposal-client"><strong>典型客户</strong>{service.client}</p>
          <dl>
            <div>
              <dt>典型问题</dt>
              <dd><ul>{service.problems.map((item) => <li>{item}</li>)}</ul></dd>
            </div>
            <div>
              <dt>交付成果</dt>
              <dd><ul>{service.output.map((item) => <li>{item}</li>)}</ul></dd>
            </div>
          </dl>
          <p class="proposal-boundary"><strong>服务边界</strong>{service.boundary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="proposal-section proposal-compare">
    <div class="proposal-intro">
      <h2>服务方式对比</h2>
      <p>合作方式取决于风险所处阶段。首次沟通用于判断方向，不替代基于完整材料形成的正式法律意见。</p>
    </div>
    <div class="proposal-process">
      <article>
        <strong>初步咨询</strong>
        <p>问题刚出现，希望快速判断性质、紧急程度和下一步。</p>
        <span>适合：单一问题、材料较少、尚未进入程序</span>
      </article>
      <article>
        <strong>专项诊断</strong>
        <p>风险已有明确节点，需要系统审阅材料并形成书面方案。</p>
        <span>适合：重大决策、争议前期、稽查或调查前后</span>
      </article>
      <article>
        <strong>项目陪伴</strong>
        <p>谈判、稽查、诉讼、调查或合规整改正在持续推进。</p>
        <span>适合：跨阶段、多方参与、需要持续响应的事项</span>
      </article>
    </div>
  </section>

  <section class="proposal-contact">
    <div>
      <h2>需要先判断风险位置？</h2>
      <p>添加微信后，请简要说明主体、事件、当前阶段与最紧迫的问题。涉及敏感信息时，可先做必要脱敏。</p>
      <span class="wechat-id-row">
        <span>微信号 <b>qiuyuwan580</b></span>
        <button type="button" class="wechat-copy-btn" data-wechat="qiuyuwan580">复制微信号</button>
      </span>
    </div>
    <img src="/images/wechat-qr-navy.png" alt="邱煜完律师微信二维码" />
  </section>
</BaseLayout>
