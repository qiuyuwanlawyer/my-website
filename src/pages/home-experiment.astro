---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  {
    index: "01",
    title: "争议解决",
    text: "围绕诉讼、仲裁、谈判、执行与复杂商事纠纷，帮助企业稳住证据、节奏与商业结果。"
  },
  {
    index: "02",
    title: "税务合规",
    text: "处理税务稽查、涉税争议、合规审查与企业经营中的税务风险防控。"
  },
  {
    index: "03",
    title: "企业刑事风险",
    text: "面向企业家、公司高管和经营活动中的刑事风险，提供前置识别与处置方案。"
  },
  {
    index: "04",
    title: "AI 数据合规",
    text: "为 AI 企业、数据产品和平台业务梳理数据来源、使用边界与合规路径。"
  }
];

const articles = [
  ["争议解决", "复杂商事争议中，企业如何先稳住证据与谈判位置"],
  ["税务合规", "税务稽查启动前后，企业经营者应关注的关键动作"],
  ["刑事风险", "企业高管面对经营刑事风险时，哪些问题不能拖"],
  ["AI 数据合规", "AI 数据服务中的合规边界，如何从业务流程里建立"],
  ["公司治理", "股东矛盾进入僵局时，经营层如何降低连带风险"],
  ["合同风控", "重大交易合同签署前，哪些条款应当重新审视"],
  ["税务合规", "企业日常报销与发票管理中的高频风险点"],
  ["争议解决", "从律师视角看商业谈判中的风险预案"],
  ["经营风险", "企业家个人责任与公司责任之间的风险隔离"]
];
---

<BaseLayout title="首页试验版 | 邱煜完律师" bodyClass="home-experiment-page" noindex={true}>
  <section class="home-hero home-hero-experiment">
    <div class="hero-copy">
      <p class="kicker refined-kicker">
        <span>争议解决</span>
        <i></i>
        <span>税务合规</span>
        <i></i>
        <span>企业刑事风险</span>
        <i></i>
        <span>AI 数据合规</span>
      </p>
      <h1><span>解决复杂法律问题，</span><span>守住商业结果。</span></h1>
      <p class="hero-lead">
        邱煜完律师专注于争议解决、税务合规、企业刑事风险处置与 AI 行业数据合规服务，致力于帮助客户商业利益最大化，法律风险最小化。
      </p>
      <div class="hero-actions">
        <a class="button primary refined-primary" href="/products">查看服务</a>
        <a class="button ghost refined-ghost" href="/articles">阅读专业文章</a>
      </div>
    </div>

    <aside class="portrait-panel" aria-label="邱煜完律师形象与微信咨询">
      <div class="portrait-glass"></div>
      <figure class="portrait-card">
        <img src="/images/profile-portrait.png" alt="邱煜完律师形象照" />
        <figcaption>
          <strong>邱煜完律师</strong>
          <span>企业经营风险法律服务</span>
        </figcaption>
      </figure>
      <div class="qr-card">
        <div class="qr-image">
          <img src="/images/wechat-qr-navy.png" alt="邱煜完律师微信二维码" />
        </div>
        <div>
          <strong>微信咨询</strong>
          <span>扫码添加，简要说明争议、税务或经营风险节点。</span>
        </div>
      </div>
    </aside>
  </section>

  <section class="service-strip" aria-label="核心业务">
    {services.map((service) => (
      <article class="service-tile">
        <em>{service.index}</em>
        <h2>{service.title}</h2>
        <p>{service.text}</p>
      </article>
    ))}
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">INSIGHTS</p>
        <h2>最新专业文章</h2>
      </div>
      <a class="text-link" href="/articles">查看全部</a>
    </div>
    <div class="article-grid">
      {articles.map(([category, title]) => (
        <article class="article-card">
          <p>{category} / 占位文章</p>
          <h3>{title}</h3>
          <span>→</span>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
