---
import BaseLayout from "../layouts/BaseLayout.astro";
import { topics } from "../data/topics";

const modules = import.meta.glob("../content/articles/*.md", { eager: true });
const articles = Object.entries(modules)
  .map(([path, module]) => ({
    slug: path.split("/").pop()?.replace(".md", ""),
    ...(module as { frontmatter: Record<string, string> }).frontmatter
  }))
  .sort((a, b) => b.date.localeCompare(a.date));

const categories = ["全部", ...new Set(articles.map((article) => article.category))];
const featured = articles.filter((article) => article.type !== "资料" && article.type !== "法规资料").slice(0, 2);
---

<BaseLayout title="平台文章 | 邱煜完律师" description="邱煜完律师关于税务刑事、企业刑事风险、税务稽查与建设工程争议的专业文章。">
  <section class="page-hero article-index-hero">
    <p class="eyebrow">ARTICLES</p>
    <h1>专业文章</h1>
    <p>记录税务刑事、企业风险与复杂争议中的实务观察。把规则讲清楚，也把规则落到经营者真正面临的选择上。</p>
  </section>

  <section class="section article-topic-hubs" aria-label="专业专题">
    <div class="section-head">
      <div><p class="eyebrow">TOPIC CLUSTERS</p><h2>按专题阅读</h2></div>
      <a class="text-link" href="/topics">查看专题总览</a>
    </div>
    <div class="article-topic-grid">
      {topics.map((topic) => (
        <a href={`/topics/${topic.slug}`}>
          <h3>{topic.shortTitle}</h3>
          <p>{topic.description}</p>
          <span>{topic.slugs.length} 篇内容 →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section article-featured" aria-label="重点文章">
    {featured.map((article, index) => (
      <a class="featured-article" href={`/articles/${article.slug}`}>
        <span>0{index + 1} / FEATURED</span>
        <p>{article.category} · {article.type}</p>
        <h2>{article.title}</h2>
        <small>{article.summary}</small>
        <em>阅读文章 →</em>
      </a>
    ))}
  </section>

  <section class="section article-tools">
    <label class="search-box">
      <span>搜索文章</span>
      <input id="article-search" type="search" placeholder="输入标题或关键词" autocomplete="off" />
    </label>
    <div class="filters" aria-label="文章分类">
      {categories.map((category, index) => (
        <button type="button" class={index === 0 ? "active" : ""} data-category={category} aria-pressed={index === 0 ? "true" : "false"}>{category}</button>
      ))}
    </div>
  </section>

  <section class="section article-catalog">
    <div class="article-catalog-head">
      <p>全部内容</p>
      <span aria-live="polite"><strong id="article-count">{articles.length}</strong> 篇</span>
    </div>
    <div class="article-list" id="article-list">
      {articles.map((article) => (
        <a class="article-row" href={`/articles/${article.slug}`} data-category={article.category} data-search={`${article.title} ${article.summary} ${article.category}`}>
          <p>{article.date.replaceAll("-", ".")}<br /><b>{article.category} · {article.type}</b></p>
          <div><h2>{article.title}</h2><small>{article.summary}</small></div>
          <span>阅读 →</span>
        </a>
      ))}
    </div>
    <p class="article-empty" id="article-empty" hidden>暂时没有匹配的文章，请换一个关键词试试。</p>
  </section>

  <script>
    const input = document.querySelector<HTMLInputElement>("#article-search");
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-category]")];
    const rows = [...document.querySelectorAll<HTMLElement>(".article-row")];
    const count = document.querySelector<HTMLElement>("#article-count");
    const empty = document.querySelector<HTMLElement>("#article-empty");
    let activeCategory = "全部";

    const update = () => {
      const query = input?.value.trim().toLocaleLowerCase("zh-CN") ?? "";
      let visible = 0;
      rows.forEach((row) => {
        const categoryMatch = activeCategory === "全部" || row.dataset.category === activeCategory;
        const searchMatch = !query || row.dataset.search?.toLocaleLowerCase("zh-CN").includes(query);
        row.hidden = !(categoryMatch && searchMatch);
        if (!row.hidden) visible += 1;
      });
      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
    };

    buttons.forEach((button) => button.addEventListener("click", () => {
      activeCategory = button.dataset.category ?? "全部";
      buttons.forEach((item) => item.classList.toggle("active", item === button));
      buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      update();
    }));
    input?.addEventListener("input", update);
  </script>
</BaseLayout>
