---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  {
    title: "争议解决专项",
    promise: "把纠纷从情绪和压力中拆出来，先稳住证据、谈判位置和诉讼节奏。",
    scene: "合同纠纷、股东争议、重大交易争议、执行压力",
    output: "争议路径评估、证据清单、谈判方案、诉讼/仲裁策略"
  },
  {
    title: "税务合规与税务争议",
    promise: "在稽查、补税、发票和历史税务问题中，先判断风险层级，再安排沟通与整改。",
    scene: "税务稽查、发票风险、历史税务问题、交易税负安排",
    output: "风险诊断、材料准备、沟通策略、整改建议"
  },
  {
    title: "企业刑事风险处置",
    promise: "帮助企业家和高管识别个人责任边界，避免经营问题被动升级为刑事风险。",
    scene: "企业家、高管、财务负责人、业务负责人面临的经营刑事风险",
    output: "风险识别、应对预案、沟通口径、责任边界梳理"
  },
  {
    title: "AI 数据合规服务",
    promise: "围绕数据来源、处理、输出和商业化，建立能被业务执行的合规路径。",
    scene: "AI 企业、数据服务商、平台业务、数据产品商业化",
    output: "数据来源审查、合规流程、合同条款、风险整改建议"
  }
];
---

<BaseLayout title="产品与服务优化提案 | 邱煜完律师">
  <section class="proposal-hero">
    <div>
      <p>企业经营风险法律服务</p>
      <h1>产品与服务</h1>
      <span>
        将争议解决、税务合规、企业刑事风险与 AI 数据合规拆成四个入口。客户先看见问题归属，再判断是否需要咨询。
      </span>
    </div>
  </section>

  <section class="proposal-section">
    <div class="proposal-intro">
      <h2>四个服务入口</h2>
      <p>
        这版弱化“产品卡片”感，改成专业服务目录。每个入口先给判断框架，再说明适用场景和交付结果。
      </p>
    </div>

    <div class="proposal-services">
      {services.map((service, index) => (
        <article class="proposal-service">
          <div class="proposal-service-head">
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{service.title}</h3>
          </div>
          <p class="proposal-promise">{service.promise}</p>
          <dl>
            <div>
              <dt>适用场景</dt>
              <dd>{service.scene}</dd>
            </div>
            <div>
              <dt>交付内容</dt>
              <dd>{service.output}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section class="proposal-section proposal-compare">
    <div class="proposal-intro">
      <h2>服务方式对比</h2>
      <p>把合作方式从“买哪个产品”改成“当前风险处在哪个阶段”。</p>
    </div>
    <div class="proposal-process">
      <article>
        <strong>初步咨询</strong>
        <p>刚出现风险，需要判断方向。</p>
        <span>输出：初步判断与下一步建议</span>
      </article>
      <article>
        <strong>专项诊断</strong>
        <p>风险已有明显节点，需要审查材料。</p>
        <span>输出：专项分析与处置方案</span>
      </article>
      <article>
        <strong>项目陪伴</strong>
        <p>谈判、稽查、诉讼或整改正在推进。</p>
        <span>输出：阶段性方案与落地执行</span>
      </article>
    </div>
  </section>

  <section class="proposal-contact">
    <div>
      <h2>需要先判断风险位置？</h2>
      <p>添加微信后，简要说明争议、税务、刑事或数据合规风险节点。</p>
    </div>
    <img src="/images/wechat-qr-navy.png" alt="邱煜完律师微信二维码" />
  </section>
</BaseLayout>
