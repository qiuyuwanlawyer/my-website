---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { whitepapers } from "../../data/whitepapers";
---
<BaseLayout
  title="白皮书 | 邱煜完律师"
  description="天驰君泰（杭州）律师事务所出品的专业白皮书：人工智能诉讼白皮书、中国企业出海用工合规白皮书，支持在线翻阅与 PDF 下载。"
>
  <section class="page-hero wp-index-hero">
    <p class="eyebrow">WHITE PAPERS</p>
    <h1>白皮书</h1>
    <p>把分散的裁判规则与实务经验整理成可以查阅的工具书。原版版面在线翻阅，也可下载 PDF 保存。</p>
  </section>

  <section class="section">
    <div class="wp-index-grid">
      {whitepapers.map((paper) => (
        <article class="wp-card">
          <a class="wp-card-cover" href={`/whitepapers/${paper.slug}`} aria-label={`在线翻阅${paper.title}`}>
            <img src={`/whitepapers/${paper.slug}/cover.jpg`} alt={`${paper.title}封面`} width="1008" height="1427" loading="lazy" decoding="async" />
          </a>
          <div class="wp-card-body">
            <p class="eyebrow">{paper.eyebrow}</p>
            <h2><a href={`/whitepapers/${paper.slug}`}>{paper.title}</a></h2>
            <p class="wp-card-sub">{paper.subtitle}</p>
            <p class="wp-card-desc">{paper.description}</p>
            <ul class="wp-card-facts">
              <li><span>页数</span><strong>{paper.pages} 页</strong></li>
              <li><span>出品</span><strong>{paper.org}</strong></li>
              <li><span>时间</span><strong>{paper.published}</strong></li>
            </ul>
            <div class="wp-card-actions">
              <a class="button primary" href={`/whitepapers/${paper.slug}`}>在线翻阅 →</a>
              <a class="text-link" href={paper.pdf} target="_blank" rel="noopener">下载 PDF</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <aside class="contact-band wp-index-contact" aria-label="微信咨询">
    <div class="contact-band-copy">
      <p class="eyebrow">CONTACT</p>
      <h2>如需联系我们</h2>
      <p>请简要说明主体、事件和当前阶段，我先帮你判断问题性质与紧迫程度。敏感材料可先做必要脱敏。</p>
    </div>
    <div class="qr-card">
      <div class="qr-image">
        <img src="/images/wechat-qr-navy.png" alt="邱煜完律师微信二维码" />
      </div>
      <div>
        <strong>微信咨询</strong>
        <span class="qr-desc">扫码添加，简要说明争议、税务或经营风险节点。</span>
        <span class="wechat-id-row">
          <span>微信号 <b>qiuyuwan580</b></span>
          <button type="button" class="wechat-copy-btn" data-wechat="qiuyuwan580">复制微信号</button>
        </span>
      </div>
    </div>
  </aside>
</BaseLayout>

<style>
  .wp-index-grid {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    display: grid;
    gap: 56px;
  }

  .wp-card {
    display: grid;
    grid-template-columns: minmax(200px, 300px) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--dark-line);
  }

  .wp-card:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .wp-card-cover {
    display: block;
    border: 1px solid var(--dark-line);
    background: #fff;
    box-shadow: 0 18px 48px rgba(6, 28, 52, 0.14);
    transition: transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
  }

  .wp-card-cover:hover {
    transform: translateY(-3px);
    box-shadow: 0 26px 64px rgba(6, 28, 52, 0.22);
  }

  .wp-card-cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  .wp-card-body h2 {
    margin: 8px 0 10px;
    font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.25;
  }

  .wp-card-body h2 a {
    color: var(--text);
    text-decoration: none;
  }

  .wp-card-sub {
    margin: 0 0 16px;
    color: var(--ocean);
    font-weight: 700;
    font-size: 16px;
  }

  .wp-card-desc {
    margin: 0;
    color: var(--text-soft);
    line-height: 1.9;
  }

  .wp-card-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--dark-line);
    border-bottom: 1px solid var(--dark-line);
  }

  .wp-card-facts li {
    padding: 16px 18px 16px 0;
  }

  .wp-card-facts li + li {
    padding-left: 18px;
    border-left: 1px solid var(--dark-line);
  }

  .wp-card-facts span {
    display: block;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--text-soft);
    margin-bottom: 4px;
  }

  .wp-card-facts strong {
    font-size: 14px;
    line-height: 1.5;
  }

  .wp-card-actions {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 28px;
  }

  .wp-card-actions .button {
    padding: 13px 26px;
    font-weight: 900;
  }

  .wp-index-contact {
    margin-top: 20px;
  }

  @media (max-width: 760px) {
    .wp-card {
      grid-template-columns: 1fr;
    }

    .wp-card-cover {
      max-width: 260px;
    }

    .wp-card-facts {
      grid-template-columns: 1fr;
    }

    .wp-card-facts li + li {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--dark-line);
    }
  }
</style>
